# The image AWS Batch runs `manage.py embed_documents --manifest` in.
#
# torch comes from PyPI with the embeddings-gpu group, and brings its own
# CUDA libraries as nvidia-* packages, so no CUDA base image is needed:
# only an NVIDIA driver on the host recent enough for torch's CUDA 13
# build (580 or later). To build for CPU instances instead:
#
#     docker build -f Dockerfile.embeddings --build-arg GROUP=embeddings .

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.31 /uv /uvx /bin/

ARG GROUP=embeddings-gpu

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    DOCLING_ARTIFACTS_PATH=/models

# git, for dc-django-utils, which uv installs from GitHub. The rest are
# the libraries OpenCV loads: RapidOCR depends on opencv-python, the
# build with a GUI, rather than opencv-python-headless.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        libgl1 \
        libglib2.0-0t64 \
        libice6 \
        libsm6 \
        libx11-6 \
        libxcb1 \
        libxext6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first, so a code change doesn't reinstall them.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --group "$GROUP"

# Docling's layout model, TableFormer and RapidOCR's models, so that jobs
# don't fetch them from Hugging Face and modelscope.cn when they start.
RUN docling-tools models download --output-dir /models \
    layout tableformer rapidocr

COPY manage.py ./
COPY lgsf_web ./lgsf_web

CMD ["python", "manage.py", "embed_documents", "--help"]
